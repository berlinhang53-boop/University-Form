
@{
    ViewBag.Title = "Admin Login";
}

<link rel="stylesheet" href="~/css/Login.css" />

<div class="student-page" style="max-width:400px; margin:60px auto;">

    <div class="student-card">

        <h3 class="section-heading text-center mb-4">Admin Login</h3>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <form method="post" asp-action="Login" asp-controller="Admin">

            <div class="mb-3">
                <label>Username</label>
                <input type="text" name="username" class="form-control" required />
            </div>

            <div class="mb-3">
                <label>Password</label>
                <input type="password" name="password" class="form-control" required />
            </div>

            <button type="submit" class="btn btn-dark w-100">Login</button>

        </form>
        @* <a asp-action="Back" asp-controller="Designation" class="page-btn  justify-content-md-center"> Home Page </a> *@


        <div class="button-container">
            <a asp-action="Back" asp-controller="Designation" class="page-btn">
                Home Page
            </a>
        </div>

    </div>

</div>